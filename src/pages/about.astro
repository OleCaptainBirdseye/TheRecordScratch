---
import BaseLayout from '../layouts/baselayout.astro';

const pageTitle = "About The Record Scratch";

const creator = {
  firstName: "Mark",
  country: "The Netherlands",
  occupation: "Real Estate Economist and Armchair Music Critic",
  hobbies: ["guitar playing", "listening to music", "reading", "whisky"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];

const happy = true;
const finished = true;
const goal = 7;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>
        
                <h2>My new Astro site!</h2>

                <p>I am working through Astro's introductory tutorial. This is the second page on my website, and it's the first one I built myself!</p>

                <p>This site will update as I complete more of the tutorial, so keep checking back and see how my journey is going!</p>

				<p>Eventually, this site will be superseded by my actual project, called In The Groove</p>

				<p>Here are a few facts about me:</p>

					<ul>
  					<li>My name is {creator.firstName}.</li>
  					<li>I live in {creator.country} and I work as a {creator.occupation}.</li>
  					{creator.hobbies.length >= 2 &&
    				<li>Two of my hobbies are: {creator.hobbies[0]} and {creator.hobbies[1]}</li>
  					}
					</ul>
					<p>My skills are:</p>
					<ul>
  					{skills.map((skill) => <li class="skill">{skill}</li>)}
					</ul>

					{happy && <p>I am happy to be learning Astro!</p>}

					{finished && <p>I finished this tutorial!</p>}

					{goal === 7 ? <p>My goal is to finish in 7 days.</p> : <p>My goal is not 7 days.</p>}
</BaseLayout>