---
import BaseLayout from '../layouts/baselayout.astro';
import BlogPost from '../components/blogpost.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Blog";
---
<BaseLayout pageTitle={pageTitle}>
	
	<h2>Here, you can find all blog posts posted to my site!</h2>
	<p>As I complete the tutorial, I'll be adding blog posts about the different sections of the tutorial here. Check back soon to see my thoughts on the different sections!</p>
	<ul>
	 {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
	</ul>
</BaseLayout>
		